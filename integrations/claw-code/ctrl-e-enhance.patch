+/// Enhance a raw prompt by invoking the `chiron-enhance` CLI tool.
+///
+/// Looks for the binary in PATH.  Falls back to the original prompt if the
+/// tool is not installed or returns an error.
+fn enhance_prompt(raw: &str) -> String {
+    use std::io::Write as _;
+
+    let spinner_msg = "\x1b[33m⚡ Enhancing prompt…\x1b[0m";
+    print!("{}", spinner_msg);
+    let _ = io::stdout().flush();
+
+    let result = Command::new("chiron-enhance")
+        .arg("--inline")
+        .stdin(std::process::Stdio::piped())
+        .stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::piped())
+        .spawn()
+        .and_then(|mut child| {
+            if let Some(stdin) = child.stdin.take() {
+                let mut stdin = stdin;
+                let _ = stdin.write_all(raw.as_bytes());
+            }
+            child.wait_with_output()
+        });
+
+    // Clear the spinner line.
+    print!("\r\x1b[K");
+    let _ = io::stdout().flush();
+
+    match result {
+        Ok(output) if output.status.success() => {
+            let enhanced = String::from_utf8_lossy(&output.stdout).trim().to_string();
+            if enhanced.is_empty() {
+                raw.to_string()
+            } else {
+                println!("\x1b[2m✨ Enhanced: {}\x1b[0m", enhanced);
+                enhanced
+            }
+        }
+        _ => {
+            // chiron-enhance not installed or failed — submit the original prompt.
+            raw.to_string()
+        }
+    }
+}
+
