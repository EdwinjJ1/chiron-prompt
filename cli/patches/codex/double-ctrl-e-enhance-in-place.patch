+    fn clear_ctrl_e_shortcut_state(&mut self) {
+        self.last_ctrl_e_press_at = None;
+    }
+
+    fn is_ctrl_e_shortcut(key_event: &KeyEvent) -> bool {
+        matches!(
+            key_event,
+            KeyEvent {
+                code: KeyCode::Char(c),
+                modifiers,
+                kind: KeyEventKind::Press | KeyEventKind::Repeat,
+                ..
+            } if *modifiers == KeyModifiers::CONTROL && c.eq_ignore_ascii_case(&'e')
+        )
+    }
+
+    fn resolve_chiron_enhancer_path(&self) -> Result<PathBuf, String> {
+        if let Some(path) = std::env::var_os(CHIRON_ENHANCER_ENV).map(PathBuf::from) {
+            if path.is_file() {
+                return Ok(path);
+            }
+            return Err(format!(
+                "{CHIRON_ENHANCER_ENV} points to a missing file: {}",
+                path.display()
+            ));
+        }
+
+        let home = std::env::var_os("HOME")
+            .or_else(|| std::env::var_os("USERPROFILE"))
+            .map(PathBuf::from)
+            .ok_or_else(|| {
+                format!(
+                    "Could not resolve a Chiron enhancer path. Set {CHIRON_ENHANCER_ENV} first."
+                )
+            })?;
+        let path = home.join(".chiron/cli/bin/chiron-enhance.mjs");
+        if path.is_file() {
+            Ok(path)
+        } else {
+            Err(format!(
+                "Chiron enhancer not found at {}. Set {CHIRON_ENHANCER_ENV} or install Chiron runtime first.",
+                path.display()
+            ))
+        }
+    }
+
+    fn run_chiron_enhancer(&self, raw_input: &str) -> Result<String, String> {
+        let enhancer_path = self.resolve_chiron_enhancer_path()?;
+        let backend = std::env::var("CHIRON_ENHANCE_BACKEND")
+            .unwrap_or_else(|_| CHIRON_DEFAULT_ENHANCE_BACKEND.to_string());
+        
+        let output = Command::new(&enhancer_path)
+            .arg(raw_input)
+            .env("CHIRON_ENHANCE_BACKEND", backend)
+            .output()
+            .map_err(|err| format!("failed to launch {}: {err}", enhancer_path.display()))?;
+
+        if !output.status.success() {
+            let stderr = String::from_utf8_lossy(&output.stderr).trim().to_string();
+            let stdout = String::from_utf8_lossy(&output.stdout).trim().to_string();
+            let detail = if !stderr.is_empty() {
+                stderr
+            } else if !stdout.is_empty() {
+                stdout
+            } else {
+                format!("process exited with {}", output.status)
+            };
+            return Err(detail);
+        }
+
+        let enhanced = String::from_utf8_lossy(&output.stdout).trim().to_string();
+        if enhanced.is_empty() {
+            return Err("enhancer returned empty output".to_string());
+        }
+        Ok(enhanced)
+    }
+
+    fn enhance_current_draft_in_place(&mut self) -> Result<(), String> {
+        if let Some(pasted) = self.paste_burst.flush_before_modified_input() {
+            self.handle_paste(pasted);
+        }
+
+        if !self.textarea.text_elements().is_empty()
+            || !self.attached_images.is_empty()
+            || !self.remote_image_urls.is_empty()
+        {
+            return Err("remove mentions or image attachments before enhancing".to_string());
+        }
+
+        let raw_input = self.current_text_with_pending();
+        if raw_input.trim().is_empty() {
+            return Err("nothing to enhance".to_string());
+        }
+
+        let enhanced = self.run_chiron_enhancer(raw_input.trim())?;
+        self.set_text_content(enhanced, Vec::new(), Vec::new());
+        self.move_cursor_to_end();
+        Ok(())
+    }
+
+    fn handle_ctrl_e_shortcut(&mut self, key_event: &KeyEvent) -> Option<(InputResult, bool)> {
+        if !Self::is_ctrl_e_shortcut(key_event) {
+            // Do not clear the state here. When advanced keyboard protocols are used (like kitty),
+            // releasing the E key but holding Ctrl, or interacting with modifiers, can generate
+            // intermediate events that break the rapid double-press. We let the timeout handle expiration.
+            return None;
+        }
+
+        let now = Instant::now();
+        let is_second_press = self
+            .last_ctrl_e_press_at
+            .is_some_and(|last| now.saturating_duration_since(last) <= CHIRON_DOUBLE_CTRL_E_TIMEOUT);
+
+        if is_second_press {
+            self.clear_ctrl_e_shortcut_state();
+            // Show inline indication before blocking to exec
+            self.set_text_content("🏹 Chiron enhancing...".to_string(), Vec::new(), Vec::new());
+            
+            // Allow ratatui to draw this draft momentarily (flush UI events)
+            let _ = std::io::Write::flush(&mut std::io::stdout());
+
+            match self.enhance_current_draft_in_place() {
+                Ok(()) => Some((InputResult::None, true)),
+                Err(err) => {
+                    self.show_footer_flash(
+                        Line::from(format!("Chiron enhance failed: {err}")),
+                        Duration::from_secs(4),
+                    );
+                    Some((InputResult::None, true))
+                }
+            }
+        } else {
+            self.last_ctrl_e_press_at = Some(now);
+            self.textarea.move_cursor_to_end_of_line(true);
+            Some((InputResult::None, true))
+        }
+    }
